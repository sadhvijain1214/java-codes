class Calculator {

    // Adding two numbers
    int add(int a, int b) {
        return a + b;
    }

    // Adding three numbers
    int add(int a, int b, int c) {
        return a + b + c;
    }

    public static void main(String[] args) {

        Calculator obj = new Calculator();

        System.out.println(obj.add(10, 20));

        System.out.println(obj.add(10, 20, 30));
    }
}
