abstract class Shape {

    abstract void draw();

    void message() {
        System.out.println("Drawing a shape");
    }
}

class Circle extends Shape {

    void draw() {
        System.out.println("Drawing Circle");
    }
}

class Main {
    public static void main(String[] args) {

        Circle c = new Circle();

        c.draw();
        c.message();
    }
}
